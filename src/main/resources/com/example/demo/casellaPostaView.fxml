<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="654.0" prefWidth="888.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.CasellaController">
    <children>
        <TableView fx:id="mailTableView" editable="true" layoutX="23.0" layoutY="103.0" onMouseClicked="#handleApriMailDoubleClick" prefHeight="420.0" prefWidth="843.0">
            <columns>
                <TableColumn prefWidth="30" text="ID">
                    <cellValueFactory>
                        <PropertyValueFactory property="id" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="196.0" text="mittente">
                    <cellValueFactory>
                        <PropertyValueFactory property="mittente" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="275.0" text="destinatari">
                    <cellValueFactory>
                        <PropertyValueFactory property="destinatari" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn editable="false" prefWidth="167.0" text="Testo mail">
                    <cellValueFactory>
                        <PropertyValueFactory property="testoMail" />
                    </cellValueFactory>
                </TableColumn>

                <TableColumn editable="false" prefWidth="174.0" text="Data">
                    <cellValueFactory>
                        <PropertyValueFactory property="data" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
            <contextMenu>
                <ContextMenu>
                    <items>
                        <MenuItem fx:id="elimina" mnemonicParsing="false" onAction="#handleEliminaRigaSelezionata" text="elimina" />
                        <MenuItem fx:id="apri" mnemonicParsing="false" onAction="#handleApriMail" text="apri" />
