         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font>
        </Label>
      <Button layoutX="141.0" layoutY="41.0" mnemonicParsing="false" onAction="#handleMostraMailUscita" prefHeight="25.0" prefWidth="108.0" text="Posta in uscita" textAlignment="CENTER" />
      <Button layoutX="262.0" layoutY="41.0" mnemonicParsing="false" onAction="#handleMostraMailInEntrata" prefHeight="25.0" prefWidth="108.0" text="Posta in entrata" textAlignment="CENTER" />
      <Button layoutX="23.0" layoutY="41.0" mnemonicParsing="false" onAction="#handleMostraTutto" prefHeight="25.0" prefWidth="108.0" text="Mostra tutto" />
