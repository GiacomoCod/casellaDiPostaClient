      <Button layoutX="443.0" layoutY="435.0" mnemonicParsing="false" onAction="#handleInvio" prefHeight="35.0" prefWidth="86.0" text="Invio" />
      <Button layoutX="536.0" layoutY="435.0" mnemonicParsing="false" onAction="#handleRicevi" prefHeight="35.0" prefWidth="86.0" text="Ricevi" />
      <Label fx:id="utente" layoutX="141.0" layoutY="14.0" text="di ">
