                </ContextMenu>
            </contextMenu>
        </TableView>

        <Button fx:id="nuovaMail" layoutX="705.0" layoutY="49.0" mnemonicParsing="false" onMouseClicked="#handleCreaNuovaMail" prefHeight="37.0" prefWidth="165.0" stylesheets="@../../../css/bottoneNuovaMail.css" text="Invia nuova mail" textAlignment="JUSTIFY" wrapText="true">
             <font>
                <Font name="Calibri Bold" size="8.0" />
             </font>
        </Button>
        <Button layoutX="727.0" layoutY="538.0" mnemonicParsing="false" onAction="#handelSvuotaCasellaDiPosta" style="-fx-background-color: #C0C0C0; -fx-border-color: gray;" text="Svuota casella di posta">
         <font>
            <Font name="Calibri" size="13.0" />
         </font></Button>

        <Label layoutX="23.0" layoutY="14.0" prefHeight="18.0" prefWidth="130.0" text="CASELLA DI POSTA">
         <font>
            <Font name="Calibri Bold Italic" size="16.0" />
         </font>
        </Label>
      <Button layoutX="141.0" layoutY="66.0" mnemonicParsing="false" onAction="#handleMostraMailUscita" prefHeight="25.0" prefWidth="108.0" text="Posta in uscita" textAlignment="CENTER">
         <font>
            <Font name="Calibri" size="12.0" />
         </font></Button>
      <Button layoutX="259.0" layoutY="66.0" mnemonicParsing="false" onAction="#handleMostraMailInEntrata" prefHeight="25.0" prefWidth="108.0" text="Posta in ingresso" textAlignment="CENTER">
         <font>
            <Font name="Calibri" size="12.0" />
         </font>
         <effect>
            <Blend />
         </effect>
         <opaqueInsets>
            <Insets />
         </opaqueInsets></Button>
      <Button layoutX="23.0" layoutY="66.0" mnemonicParsing="false" onAction="#handleMostraTutto" prefHeight="25.0" prefWidth="108.0" text="Mostra tutto">
         <font>
            <Font name="Calibri" size="12.0" />
         </font></Button>
      <Button layoutX="378.0" layoutY="66.0" mnemonicParsing="false" onAction="#handleMostraPostaInviata" prefHeight="25.0" prefWidth="108.0" text="Posta Inviata" textAlignment="CENTER">
         <font>
            <Font name="Calibri" size="12.0" />
         </font></Button>
      <Button fx:id="prova" layoutX="281.0" layoutY="548.0" mnemonicParsing="false" onAction="#handleInvio" prefHeight="35.0" prefWidth="86.0" stylesheets="@../../../css/bottoneNuovaMail.css" text="Invio" />
      <Button layoutX="378.0" layoutY="546.0" mnemonicParsing="false" onAction="#handleRicevi" prefHeight="35.0" prefWidth="86.0" text="Ricevi" />
      <Label fx:id="utente" layoutX="156.0" layoutY="11.0" prefHeight="25.0" prefWidth="198.0" text="di ">
         <font>
            <Font name="Arial Italic" size="12.0" />
         </font>
      </Label>
      <Button layoutX="502.0" layoutY="551.0" mnemonicParsing="false" onAction="#handleAvviaSessioneAutomatica" prefHeight="25.0" prefWidth="116.0" text="Automatica" />
