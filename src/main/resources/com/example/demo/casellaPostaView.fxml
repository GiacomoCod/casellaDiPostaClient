                <TableColumn prefWidth="30" text="ID">
                    <cellValueFactory>
                        <PropertyValueFactory property="id" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="125.0" text="mittente">
                    <cellValueFactory>
                        <PropertyValueFactory property="mittente" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="125.0" text="destinatari">
                    <cellValueFactory>
                        <PropertyValueFactory property="destinatari" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn editable="false" prefWidth="259.0" text="testoMail">
                    <cellValueFactory>
                        <PropertyValueFactory property="testoMail" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn editable="false" prefWidth="201.0" text="Data">
                    <cellValueFactory>
                        <PropertyValueFactory property="data" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
            <contextMenu>
                <ContextMenu>
                    <items>
                        <MenuItem fx:id="elimina" mnemonicParsing="false" onAction="#handleEliminaRigaSelezionata" text="elimina" />
