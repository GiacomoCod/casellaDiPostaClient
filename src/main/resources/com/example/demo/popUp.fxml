<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="300.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.PopUpController">
    <children>
        <Label fx:id="text" prefWidth="300.0" text="Messaggio dinamico" wrapText="true">
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
         <font>
            <Font name="Calibri" size="14.0" />
         </font>
        </Label>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <children>
                <Button fx:id="cancelButton" cancelButton="true" onAction="#back" text="Annulla">
               <font>
                  <Font name="Calibri" size="13.0" />
               </font></Button>
                <Button fx:id="okButton" onAction="#confirm" text="Ok">
               <font>
                  <Font name="Calibri" size="13.0" />
               </font></Button>
            </children>
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
        </HBox>
    </children>
</VBox>
